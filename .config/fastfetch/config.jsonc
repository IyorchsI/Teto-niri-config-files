{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "/mnt/ssd/tetofiles/Teto-niri-config-files/images/fastfetch/*.png",
        "width": 16,
        "height": 8,
        "padding": {
            "top": 1,
            "left": 1
        }
    },
  "display": {
    "percent": {
      "color": {
        "green": "black",
        "yellow": "#79716B",
        "red": "white"
      }
    }
  },
  "modules": [
    {
      "type": "host",
      "keyColor": "black",
      "outputColor": "black"
    },
    "break",
    {
      "type": "os",
      "keyColor": "black",
      "outputColor": "black"
    },
    {
      "type": "kernel",
      "keyColor": "black",
      "outputColor": "black"
    },
    {
      "type": "packages",
      "keyColor": "black",
      "outputColor": "black"
    },
    {
      "type": "shell",
      "keyColor": "black",
      "outputColor": "black"
    },
    {
      "type": "terminal",
      "keyColor": "black",
      "outputColor": "black"
    },
    {
      "type": "wm",
      "keyColor": "black",
      "outputColor": "black"
    },
    "break",
    {
      "type": "display",
      "keyColor": "black",
      "showPeCoreCount": true,
      "outputColor": "black"
    },
    {
      "type": "cpu",
      "keyColor": "black",
      "outputColor": "black"
    },
    {
      "type": "gpu",
      "keyColor": "black",
      "outputColor": "black"
    },
    "break",
    {
      "type": "memory",
      "keyColor": "black",
      "outputColor": "black",
      "percent": {
            "black": 20, // Shows result in green when the usage is less than 20%
            "black": 50, // Shows result in yellow when the usage is between 20% and 50%
                        // Shows result in red when the usage is greater than 50%
        }

    },
    {
      "type": "swap",
      "keyColor": "black",
      "outputColor": "black",
      "percent": {
            "black": 20, // Shows result in green when the usage is less than 20%
            "black": 50, // Shows result in yellow when the usage is between 20% and 50%
                        // Shows result in red when the usage is greater than 50%
        }
    },
    {
      "type": "disk",
      "keyColor": "black",
      "outputColor": "black"
    },
    "break",
    {
      "type": "uptime",
      "keyColor": "black",
      "outputColor": "black"
    },
    {
      "type": "command",
      "key": "OS Age",
      "keyColor": "black",
      "outputColor": "black",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    }
  ]
}
