{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
      "logo": {
          "type": "small",
          "padding": {
              "top": 1,
              "right": 2
          },
          "color": {
          "1": "black",
          "2": "black"
          }
        },
  "display": {
    "percent": {
      "color": {
        "green": "black",
        "yellow": "#79716B",
        "red": "white"
      }
    }
  },
  "modules": [
    {
      "type": "host",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    "break",
    {
      "type": "os",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    {
      "type": "kernel",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    {
      "type": "packages",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    {
      "type": "shell",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    {
      "type": "terminal",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    {
      "type": "wm",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    "break",
    {
      "type": "display",
      "keyColor": "black",
      "showPeCoreCount": true,
      "outputColor": "#050505"
    },
    {
      "type": "cpu",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    {
      "type": "gpu",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    "break",
    {
      "type": "memory",
      "keyColor": "black",
      "outputColor": "#050505",
      "percent": {
            "black": 20, // Shows result in green when the usage is less than 20%
            "black": 50, // Shows result in yellow when the usage is between 20% and 50%
                        // Shows result in red when the usage is greater than 50%
        }

    },
    {
      "type": "swap",
      "keyColor": "black",
      "outputColor": "#050505",
      "percent": {
            "black": 20, // Shows result in green when the usage is less than 20%
            "black": 50, // Shows result in yellow when the usage is between 20% and 50%
                        // Shows result in red when the usage is greater than 50%
        }
    },
    {
      "type": "disk",
      "keyColor": "black",
      "outputColor": "black"
    },
    "break",
    {
      "type": "uptime",
      "keyColor": "black",
      "outputColor": "#050505"
    },
    {
      "type": "command",
      "key": "OS Age",
      "keyColor": "black",
      "outputColor": "#050505",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    }
  ]
}
